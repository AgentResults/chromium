# Aurelian — Velite's Chromium embodiment.

import("//build/config/compiler/compiler.gni")
import("//testing/test.gni")
import("//testing/test.gni")

declare_args() {
  enable_aurelian = true
}

if (enable_aurelian) {
  _velite_src = "../../../Legion/Velite/src"

  _velite_include_dirs = [
    "$_velite_src/agentspaces-wire/include",
    "$_velite_src/agentspaces/include",
    "$_velite_src/capability/include",
    "$_velite_src/causal/include",
    "$_velite_src/channel/include",
    "$_velite_src/crypto/include",
    "$_velite_src/dataflow/include",
    "$_velite_src/dispatch/include",
    "$_velite_src/envelope/include",
    "$_velite_src/envelopes/include",
    "$_velite_src/fact-log/include",
    "$_velite_src/fact-substrate/include",
    "$_velite_src/forth/include",
    "$_velite_src/forth-handle/include",
    "$_velite_src/handle/include",
    "$_velite_src/host/include",
    "$_velite_src/identity/include",
    "$_velite_src/json/include",
    "$_velite_src/lattices/include",
    "$_velite_src/origin-sequence/include",
    "$_velite_src/resources/include",
    "$_velite_src/substrate/include",
    "$_velite_src/crypto/vendor",
    "$_velite_src/mt/runtime/include",
    "$_velite_src/mt/compiler/include",
  ]

  # Install-membrane: the typed EmbodimentPolicy (C++ legion://types/
  # EmbodimentPolicy). No RTTI; no ambient deps. (AURELIAN-DESIGN.md §4.5)
  source_set("aurelian_embodiment_policy") {
    sources = [
      "membrane/embodiment_policy.cc",
      "membrane/embodiment_policy.h",
    ]

    deps = [ "//base" ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Federation-wire reply serializer. Light (velite + base only) so the root
  # handle AND a fast unittest can share it. RTTI (touches Velite Value/Handle).
  source_set("aurelian_wire_serialize") {
    sources = [
      "handles/root/wire_serialize.cc",
      "handles/root/wire_serialize.h",
    ]

    deps = [
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-2 (HS-1) grep-assert: no base::RunLoop in the new async layer —
  # build-time, so the invariant cannot rot silently (design section 3).
  action("aurelian_hs1_no_runloop_audit") {
    script = "mirror/no_runloop_audit.py"
    _audited = [
      "mirror/cdp_agent_client.cc",
      "mirror/cdp_agent_client.h",
      "mirror/cdp_session.cc",
      "mirror/cdp_session.h",
      "mirror/targets_mirror.cc",
      "mirror/targets_mirror.h",
      "mirror/value_convert.cc",
      "mirror/value_convert.h",
      "federation/completion_bridge.cc",
      "federation/completion_bridge.h",
      "federation/bridge_dispatch.cc",
      "federation/bridge_dispatch.h",
    ]
    inputs = _audited
    outputs = [ "$target_gen_dir/hs1_no_runloop_audit.stamp" ]
    args = [
             "--stamp",
             rebase_path("$target_gen_dir/hs1_no_runloop_audit.stamp",
                         root_build_dir),
           ] + rebase_path(_audited, root_build_dir)
  }

  # ACM-2 (HS-1): the content-layer half of the persistent session — the
  # long-lived DevToolsAgentHostClient behind a plain API. SEPARATE no-RTTI
  # source_set: the content base's typeinfo is not emitted in the no-RTTI
  # build, so the RTTI session TU cannot subclass it directly.
  source_set("aurelian_cdp_agent_client") {
    sources = [
      "mirror/cdp_agent_client.cc",
      "mirror/cdp_agent_client.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # ACM-2 (HS-1): the async CDP session layer — persistent per-target
  # client, monotonic ids, request/reply correlation, settlement via
  # pending-Handle resolution on the UI thread (design section 3). RTTI
  # (Velite handles).
  source_set("aurelian_cdp_session") {
    sources = [
      "mirror/cdp_session.cc",
      "mirror/cdp_session.h",
      "mirror/value_convert.cc",
      "mirror/value_convert.h",
    ]

    deps = [
      ":aurelian_catalog",
      ":aurelian_cdp_agent_client",
      ":aurelian_completion_bridge",
      ":aurelian_hs1_no_runloop_audit",
      ":aurelian_streams",
      "//base",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-1: the CDP catalog mirror — ONE data-driven node class projecting
  # the embedded descriptor (no per-domain code). RTTI (Velite handles).
  source_set("aurelian_cdp_mirror") {
    sources = [
      "mirror/cdp_mirror.cc",
      "mirror/cdp_mirror.h",
    ]

    deps = [
      ":aurelian_catalog",
      ":aurelian_cdp_session",
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-3: the targets mirror — typed live targets over
  # DevToolsAgentHost::GetOrCreateAll(), each target carrying its own
  # per-target cdp sub-mirror (the page-scoped invoke surface). RTTI
  # (Velite handles); using content's refcounted host needs no typeinfo.
  source_set("aurelian_targets_mirror") {
    sources = [
      "mirror/targets_mirror.cc",
      "mirror/targets_mirror.h",
    ]

    deps = [
      ":aurelian_cdp_mirror",
      "//base",
      "//content/public/browser",
      "//url",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-5: the prefs mirror — the live profile's PrefService registry
  # projected (names/types/defaults are the host's). RTTI (Velite handles);
  # profile reach via BrowserList + the component-layer user_prefs
  # association (no profile-monolith dependency).
  source_set("aurelian_prefs_mirror") {
    sources = [
      "mirror/prefs_mirror.cc",
      "mirror/prefs_mirror.h",
    ]

    deps = [
      ":aurelian_cdp_session",  # value_convert (the one converter pair)
      "//base",
      "//chrome/browser/ui",
      "//components/prefs",
      "//components/user_prefs",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-6: the services catalog — the KeyedServiceFactory dependency graph
  # enumerated through the one-line additive production accessor on
  # DependencyManager (the recorded section-7 fork-delta line). CATALOG-ONLY:
  # invoke answers the typed no-invoke-surface refusal. RTTI (Velite handles).
  source_set("aurelian_services_mirror") {
    sources = [
      "mirror/services_mirror.cc",
      "mirror/services_mirror.h",
    ]

    deps = [
      "//base",
      "//components/keyed_service/content",
      "//components/keyed_service/core",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # Navigable legion://chrome/ root handle (reachable-from-root). RTTI (Velite).
  source_set("aurelian_root") {
    sources = [
      "handles/root/root_handle.cc",
      "handles/root/root_handle.h",
    ]

    deps = [
      # ACM-7: the three ontology audits gate the composition root, so no
      # binary links the mirror without the binding holding (design
      # section 6). ACM-R adds the no-parallel-bespoke lock (section 7).
      ":aurelian_host_correspondence_audit",
      ":aurelian_no_parallel_bespoke_audit",
      ":aurelian_ontology_consistency_audit",
      ":aurelian_surface_coverage_audit",

      ":aurelian_cdp_mirror",
      ":aurelian_cdp_session",
      ":aurelian_prefs_mirror",
      ":aurelian_services_mirror",
      ":aurelian_targets_mirror",
      ":aurelian_embodiment_policy",
      ":aurelian_media",
      ":aurelian_wire_serialize",
      "//base",
      "//chrome/browser/ui",
      "//chrome/browser/ui/tabs:tab_strip",
      "//content/public/browser",
      "//url",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # The one-shot install (genesis seam): ambient authority -> sealed Handle
  # graph, per-AgentSpace one-shot + revocable. RTTI (touches Velite AgentSpace).
  source_set("aurelian_install") {
    sources = [
      "membrane/install.cc",
      "membrane/install.h",
    ]

    deps = [
      ":aurelian_embodiment_policy",
      ":aurelian_root",
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # DevTools CDP-compat command surface (C7.d). No RTTI.
  source_set("aurelian_devtools") {
    sources = [
      "handles/browser/devtools_handle.cc",
      "handles/browser/devtools_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Cap-token attenuation: predicates (C8.a) + signed delegation chain (C8.b).
  # No RTTI; uses Velite's crypto free functions for Ed25519.
  source_set("aurelian_capability") {
    sources = [
      "capability/cap_chain.cc",
      "capability/cap_chain.h",
      "capability/cap_gate.cc",
      "capability/cap_gate.h",
      "capability/cap_membrane.cc",
      "capability/cap_membrane.h",
      "capability/cap_predicate.cc",
      "capability/cap_predicate.h",
      "capability/cap_wire.cc",
      "capability/cap_wire.h",
    ]

    deps = [
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C9 bring-up external WSS peer (design §13). No RTTI; uses Velite's
  # WebSocket channel/listener + AgentSpace root handle.
  # C9 — the machine-federation register-in (register the `chrome` facet INTO
  # Agrippa over the local UDS, AURELIAN-DESIGN §3.6/§13). ChromeRoot-free: the
  # caller injects the ChromeDispatchFn, so this links //velite only (the unit
  # test does not drag in aurelian_root / chrome-browser handles).
  source_set("aurelian_uds_register") {
    sources = [
      "federation/uds_register.cc",
      "federation/uds_register.h",
    ]

    deps = [
      # ACM-8: the dispatchAt seam runs the federation cap gate.
      ":aurelian_capability",
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # ACM-2 (HS-1): the completion-signaled bridge MECHANISM (design section
  # 3) — completion record + mutex-protected live set + UI-confined
  # settlement registrar + Stop() drain. ChromeRoot-free and content-free
  # so the timeout/CAS/drain pins run at unit tier. RTTI (Velite handles).
  source_set("aurelian_completion_bridge") {
    sources = [
      "federation/completion_bridge.cc",
      "federation/completion_bridge.h",
    ]

    deps = [
      ":aurelian_wire_serialize",
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # ACM-2 (HS-1): the ONE serve-thread blocking dispatch glue both wire
  # bridge sites consume (the UDS register-in lambda + the WSS scaffold).
  source_set("aurelian_bridge_dispatch") {
    sources = [
      "federation/bridge_dispatch.cc",
      "federation/bridge_dispatch.h",
    ]

    deps = [
      ":aurelian_completion_bridge",
      ":aurelian_root",
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # AU-CAP-LIVE: provisions the operator cap trust anchor onto each renderer
  # frame's membrane at boot (the live half of C8). No RTTI; talks the
  # AurelianWire mojom to the renderer.
  source_set("aurelian_cap_anchor_provisioner") {
    sources = [
      "capability/cap_anchor_provisioner.cc",
      "capability/cap_anchor_provisioner.h",
    ]

    deps = [
      "//aurelian/public/mojom",
      "//base",
      "//content/public/browser",
      "//mojo/public/cpp/bindings",
      "//third_party/blink/public/common",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Subscription stream producer (C6). No RTTI (no dynamic_cast here; uses
  # Velite's SubscriptionHandle, whose typeinfo is provided by //velite).
  source_set("aurelian_streams") {
    sources = [
      "handles/streams/mojo_stream_bridge.cc",
      "handles/streams/mojo_stream_bridge.h",
      "handles/streams/subscription_producer.cc",
      "handles/streams/subscription_producer.h",
    ]

    deps = [
      "//aurelian/public/mojom",
      "//base",
      "//mojo/public/cpp/bindings",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C-MEDIA-1: the process-global MediaSeam frame buffer — plain C++ (//base
  # only, no Velite/RTTI), so the content-layer capture device (no-RTTI) and the
  # Velite media Handles can both read it.
  source_set("aurelian_media_seam") {
    sources = [
      "handles/media/media_seam.cc",
      "handles/media/media_seam.h",
    ]

    deps = [ "//base" ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C-MEDIA-1: the bindable media Handle surface (video_sink / audio_sink /
  # audio_source) over the MediaSeam. RTTI (Velite handle code). //base +
  # //velite + the streams producer only — no chrome handles, so the unit test
  # links light.
  source_set("aurelian_media") {
    sources = [
      "handles/media/media_handles.cc",
      "handles/media/media_handles.h",
    ]

    deps = [
      ":aurelian_media_seam",
      ":aurelian_streams",
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # C-MEDIA-2d: the TTS virtual microphone producer. Drains MediaSeam audio into
  # the shared-memory ring buffer the fork's FakeAudioInputStream reads as the
  # browser mic. No RTTI / no Velite (plain POSIX shm + //base).
  source_set("aurelian_virtual_mic") {
    sources = [
      "media/aurelian_virtual_mic.cc",
      "media/aurelian_virtual_mic.h",
    ]

    deps = [
      ":aurelian_media_seam",
      "//base",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C-MEDIA-2: the content-layer virtual camera. Registers a REAL enumerable
  # camera with Chromium's video capture service (the honest browser-process
  # virtual-device seam), so the avatar appears to getUserMedia as the browser
  # camera. No RTTI / no Velite (pure content+media+mojo).
  source_set("aurelian_virtual_camera") {
    sources = [
      "media/aurelian_virtual_camera.cc",
      "media/aurelian_virtual_camera.h",
    ]

    deps = [
      ":aurelian_media_seam",
      "//base",
      "//content/public/browser",
      "//media",
      "//media/capture:capture_lib",
      "//media/capture/mojom:video_capture_buffer",
      "//mojo/public/cpp/bindings",
      "//services/video_capture/public/mojom",
      "//ui/gfx/geometry",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C10: existing asmodeus tab-audio capture routed through a Velite handle.
  # RTTI (Velite handle code).
  source_set("aurelian_audio") {
    sources = [
      "handles/profile/audio_capture_handle.cc",
      "handles/profile/audio_capture_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/asmodeus:asmodeus",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # C10: existing asmodeus CredentialStore routed through a Velite handle.
  # RTTI (Velite handle code).
  source_set("aurelian_credentials") {
    sources = [
      "handles/profile/credentials_handle.cc",
      "handles/profile/credentials_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/asmodeus:asmodeus_automation_core",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # Bootstrap — compiled as normal Chromium code (no RTTI).
  source_set("aurelian") {
    sources = [
      "bootstrap/browser_main_extra.cc",
      "bootstrap/browser_main_extra.h",
    ]

    deps = [
      ":aurelian_bridge_dispatch",
      ":aurelian_cap_anchor_provisioner",
      ":aurelian_completion_bridge",
      ":aurelian_embodiment_policy",
      ":aurelian_install",
      ":aurelian_root",
      ":aurelian_uds_register",
      ":aurelian_virtual_camera",
      ":aurelian_virtual_mic",
      "//base",
      "//chrome/browser:main_extra_parts",
      "//chrome/browser/ui",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Unit tests — pure in-process substrate/handle logic (no browser).
  test("aurelian_unittests") {
    sources = [
      "capability/cap_chain_unittest.cc",
      "capability/cap_membrane_unittest.cc",
      "capability/cap_predicate_unittest.cc",
      "federation/completion_bridge_unittest.cc",
      "federation/conformance_bootstrap_link_unittest.cc",
      "federation/uds_register_unittest.cc",
      "handles/media/media_seam_unittest.cc",
      "media/aurelian_virtual_mic_unittest.cc",
      "handles/profile/credentials_handle_unittest.cc",
      "handles/root/wire_serialize_unittest.cc",
      "handles/streams/subscription_producer_unittest.cc",
    ]

    deps = [
      ":aurelian_capability",
      ":aurelian_completion_bridge",
      ":aurelian_credentials",
      ":aurelian_media",
      ":aurelian_streams",
      ":aurelian_uds_register",
      ":aurelian_virtual_mic",
      ":aurelian_wire_serialize",
      "//base",
      "//base/test:run_all_unittests",
      "//base/test:test_support",
      "//chrome/browser/asmodeus:asmodeus_automation_core",
      "//testing/gtest",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # ACM-S2 - the embedded CDP descriptor + derived session-context data
  # (AURELIAN-GENERIC-CONTROL-TDD-PLAN Phase 0; design sections 2 and 4).
  # The descriptor is embedded as DATA, regenerated with every Chromium
  # roll, so the mirror tracks upstream by construction.
  action("aurelian_catalog_embed") {
    script = "catalog/embed_json.py"
    inputs = [
      "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
      "catalog/session_context_table.json",
      "catalog/command_overrides.json",
      "catalog/renderer_served.json",
    ]
    outputs = [
      "$target_gen_dir/catalog/embedded_catalog_data.cc",
      "$target_gen_dir/catalog/embedded_catalog_data.h",
    ]
    args = [
      "--protocol",
      rebase_path(
          "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
          root_build_dir),
      "--table",
      rebase_path("catalog/session_context_table.json", root_build_dir),
      "--overrides",
      rebase_path("catalog/command_overrides.json", root_build_dir),
      "--renderer-served",
      rebase_path("catalog/renderer_served.json", root_build_dir),
      "--out-cc",
      rebase_path("$target_gen_dir/catalog/embedded_catalog_data.cc",
                  root_build_dir),
      "--out-h",
      rebase_path("$target_gen_dir/catalog/embedded_catalog_data.h",
                  root_build_dir),
    ]
    deps = [ "//third_party/blink/public/devtools_protocol:protocol_version" ]
  }

  # The build-time REGENERATION AUDIT: a fresh derivation from the three
  # browser-process registration sites must equal the checked-in table -
  # drift fails the build (design section 2 round-8; the planted-drift
  # RED edits a row and watches this action fail).
  action("aurelian_session_context_audit") {
    script = "catalog/derive_session_context.py"
    inputs = [
      "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
      "catalog/session_context_table.json",
      "catalog/renderer_served.json",
      "//content/browser/devtools/browser_devtools_agent_host.cc",
      "//content/browser/devtools/render_frame_devtools_agent_host.cc",
      "//chrome/browser/devtools/chrome_devtools_session.cc",
    ]
    outputs = [ "$target_gen_dir/catalog/session_context_audit.stamp" ]
    args = [
      "--src-root",
      rebase_path("//", root_build_dir),
      "--descriptor",
      rebase_path(
          "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
          root_build_dir),
      "--renderer-served",
      rebase_path("catalog/renderer_served.json", root_build_dir),
      "--check",
      rebase_path("catalog/session_context_table.json", root_build_dir),
      "--stamp",
      rebase_path("$target_gen_dir/catalog/session_context_audit.stamp",
                  root_build_dir),
    ]
    deps = [ "//third_party/blink/public/devtools_protocol:protocol_version" ]
  }

  # ACM-7 audit 1 - acm-ontology-consistency (design section 6): every
  # legion://types/ stamp in the projector/facade sources declared, every
  # declared type stamped (Phase-A review F2 both-directions discipline)
  # and IDENTIFIES a declared canonical target.
  action("aurelian_ontology_consistency_audit") {
    script = "ontology/ontology_consistency_audit.py"
    inputs = [
      "ontology/ontology_lib.py",
      "ontology/aurelian-source-domain.ontology.yaml",

      # The scan scope - the union of the ontology roots rows' files.
      "mirror/cdp_mirror.cc",
      "mirror/cdp_mirror.h",
      "mirror/cdp_session.cc",
      "mirror/cdp_session.h",
      "mirror/cdp_agent_client.cc",
      "mirror/cdp_agent_client.h",
      "mirror/value_convert.cc",
      "mirror/value_convert.h",
      "mirror/targets_mirror.cc",
      "mirror/targets_mirror.h",
      "mirror/prefs_mirror.cc",
      "mirror/prefs_mirror.h",
      "mirror/services_mirror.cc",
      "mirror/services_mirror.h",
      "handles/root/root_handle.cc",
      "handles/media/media_handles.cc",
      "handles/media/media_handles.h",
    ]
    outputs = [ "$target_gen_dir/ontology_consistency_audit.stamp" ]
    args = [
      "--src-root",
      rebase_path("//", root_build_dir),
      "--ontology",
      rebase_path("ontology/aurelian-source-domain.ontology.yaml",
                  root_build_dir),
      "--stamp",
      rebase_path("$target_gen_dir/ontology_consistency_audit.stamp",
                  root_build_dir),
    ]
  }

  # ACM-7 audit 2 - acm-surface-coverage (design section 6): mounted set ==
  # EmbodimentPolicy rows == ontology roots rows (projector or recorded
  # facade), plus the generated wiring-map drift check.
  action("aurelian_surface_coverage_audit") {
    script = "ontology/surface_coverage_audit.py"
    inputs = [
      "ontology/ontology_lib.py",
      "ontology/aurelian-source-domain.ontology.yaml",
      "ontology/AURELIAN-WIRING-MAP.md",
      "handles/root/root_handle.cc",
      "membrane/embodiment_policy.cc",
      "mirror/cdp_mirror.cc",
      "mirror/targets_mirror.cc",
      "mirror/prefs_mirror.cc",
      "mirror/services_mirror.cc",
    ]
    outputs = [ "$target_gen_dir/surface_coverage_audit.stamp" ]
    args = [
      "--src-root",
      rebase_path("//", root_build_dir),
      "--ontology",
      rebase_path("ontology/aurelian-source-domain.ontology.yaml",
                  root_build_dir),
      "--map",
      rebase_path("ontology/AURELIAN-WIRING-MAP.md", root_build_dir),
      "--stamp",
      rebase_path("$target_gen_dir/surface_coverage_audit.stamp",
                  root_build_dir),
    ]
  }

  # ACM-7 audit 3 - the HOST-side correspondence audit (design section 6,
  # round-5 review M7): every host self-describing structure family ->
  # projector or recorded out-of-scope row, each family pinned to a live
  # host anchor; the descriptor leg re-parses per build (auto-grows with
  # every roll).
  # ACM-R: the no-parallel-bespoke lock (design section 7, HS-2 —
  # GRC-14-style). Gates aurelian_root like the three ACM-7 audits: no
  # binary links the composition root while a bespoke file lacks its ONE
  # executed inventory disposition, a DELETE-row file survives, a facade
  # verb shadows the mirror unrecorded, or a row escapes audit scope. The
  # audit enumerates the live tree (scope globs), so its inputs name the
  # decision sources; deletions re-verify on the next inventory/root edit
  # or standalone run.
  action("aurelian_no_parallel_bespoke_audit") {
    script = "inventory/no_parallel_bespoke_audit.py"
    inputs = [
      "docs/AURELIAN-BESPOKE-INVENTORY.md",
      "handles/root/root_handle.cc",
    ]
    outputs = [ "$target_gen_dir/no_parallel_bespoke_audit.stamp" ]
    args = [
      "--aurelian-root",
      rebase_path(".", root_build_dir),
      "--inventory",
      rebase_path("docs/AURELIAN-BESPOKE-INVENTORY.md", root_build_dir),
      "--stamp",
      rebase_path("$target_gen_dir/no_parallel_bespoke_audit.stamp",
                  root_build_dir),
    ]
  }

  action("aurelian_host_correspondence_audit") {
    script = "ontology/host_correspondence_audit.py"
    inputs = [
      "ontology/ontology_lib.py",
      "ontology/aurelian-source-domain.ontology.yaml",
      "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
      "//components/prefs/pref_service.h",
      "//content/public/browser/devtools_agent_host.h",
      "//components/keyed_service/core/dependency_manager.h",
      "//base/feature_list.h",
      "//third_party/blink/public/mojom/browser_interface_broker.mojom",
      "//base/command_line.h",
      "//base/metrics/histogram.h",
      "//extensions/browser/extension_registry.h",
    ]
    outputs = [ "$target_gen_dir/host_correspondence_audit.stamp" ]
    args = [
      "--src-root",
      rebase_path("//", root_build_dir),
      "--ontology",
      rebase_path("ontology/aurelian-source-domain.ontology.yaml",
                  root_build_dir),
      "--descriptor",
      rebase_path(
          "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
          root_build_dir),
      "--stamp",
      rebase_path("$target_gen_dir/host_correspondence_audit.stamp",
                  root_build_dir),
    ]
    deps = [ "//third_party/blink/public/devtools_protocol:protocol_version" ]
  }

  # The catalog the ACM-1 mirror projects from.
  source_set("aurelian_catalog") {
    sources = [
      "catalog/cdp_catalog.cc",
      "catalog/cdp_catalog.h",
    ]
    sources += get_target_outputs(":aurelian_catalog_embed")
    deps = [
      ":aurelian_catalog_embed",
      ":aurelian_session_context_audit",
      "//base",
    ]
  }

  # Dedicated test binary — embedded-subsystem convention (like
  # extensions_browsertests, headless_browsertests).
  test("aurelian_browsertests") {
    sources = [
      "bootstrap/boot_register_browsertest.cc",
      "capability/cap_membrane_browsertest.cc",
      "catalog/session_context_browsertest.cc",
      "federation/one_root_browsertest.cc",
      "handles/profile/audio_capture_handle_browsertest.cc",
      "handles/browser/devtools_handle_browsertest.cc",
      "handles/root/root_handle_browsertest.cc",
      "handles/root/tab_reach_browsertest.cc",
      "membrane/install_browsertest.cc",
      "mirror/cdp_event_subscribe_browsertest.cc",
      "mirror/cdp_mirror_browsertest.cc",
      "mirror/cdp_session_browsertest.cc",
      "mirror/prefs_mirror_browsertest.cc",
      "mirror/services_mirror_browsertest.cc",
      "mirror/targets_mirror_browsertest.cc",
      "handles/streams/stream_subscription_browsertest.cc",
      "media/aurelian_virtual_camera_browsertest.cc",
      "renderer/aurelian_wire_browsertest.cc",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    deps = [
      ":aurelian",
      ":aurelian_audio",
      ":aurelian_catalog",
      ":aurelian_cdp_mirror",
      ":aurelian_cdp_session",
      ":aurelian_targets_mirror",
      ":aurelian_capability",
      ":aurelian_completion_bridge",
      ":aurelian_wire_serialize",
      ":aurelian_devtools",
      ":aurelian_embodiment_policy",
      ":aurelian_install",
      ":aurelian_root",
      ":aurelian_streams",
      ":aurelian_virtual_camera",
      "//aurelian/public/mojom",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/browser/ui",
      "//media",
      "//media/capture:capture_switches",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
      "//components/keyed_service/content",
      "//components/keyed_service/core",
      "//content/public/browser",
      "//content/test:test_support",
      "//gpu/config",
      "//mojo/public/cpp/bindings",
      "//net",
      "//net:test_support",
      "//testing/gtest",
      "//third_party/blink/public/common",
      "//url",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]

    data_deps = [ "//chrome" ]
  }
}
