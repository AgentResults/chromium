# Aurelian — Velite's Chromium embodiment.

import("//build/config/compiler/compiler.gni")
import("//testing/test.gni")
import("//testing/test.gni")

declare_args() {
  enable_aurelian = true
}

if (enable_aurelian) {
  _velite_src = "../../../Legion/Velite/src"

  _velite_include_dirs = [
    "$_velite_src/agentspaces-wire/include",
    "$_velite_src/agentspaces/include",
    "$_velite_src/capability/include",
    "$_velite_src/causal/include",
    "$_velite_src/channel/include",
    "$_velite_src/crypto/include",
    "$_velite_src/dataflow/include",
    "$_velite_src/dispatch/include",
    "$_velite_src/envelope/include",
    "$_velite_src/envelopes/include",
    "$_velite_src/fact-log/include",
    "$_velite_src/fact-substrate/include",
    "$_velite_src/forth/include",
    "$_velite_src/forth-handle/include",
    "$_velite_src/handle/include",
    "$_velite_src/host/include",
    "$_velite_src/identity/include",
    "$_velite_src/json/include",
    "$_velite_src/lattices/include",
    "$_velite_src/origin-sequence/include",
    "$_velite_src/resources/include",
    "$_velite_src/substrate/include",
    "$_velite_src/crypto/vendor",
    "$_velite_src/mt/runtime/include",
    "$_velite_src/mt/compiler/include",
  ]

  # Velite handle code — compiled with RTTI (Velite uses dynamic_cast).
  # Network intercept + cookie handles (no RTTI — used by chrome/browser).
  source_set("aurelian_network") {
    sources = [
      "handles/network/network_handle.cc",
      "handles/network/network_handle.h",
    ]

    deps = [
      "//base",
      "//components/download/public/common:public",
      "//content/public/browser",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//third_party/blink/public/common",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Velite handle code — compiled with RTTI.
  source_set("aurelian_handles") {
    sources = [
      "handles/browser/tab_handle.cc",
      "handles/browser/tab_handle.h",
    ]

    deps = [
      "//aurelian/public/mojom",
      "//base",
      "//components/input",
      "//content/public/browser",
      "//mojo/public/cpp/bindings",
      "//third_party/blink/public/common",
      "//ui/base",
      "//ui/events:dom_keycode_converter",
      "//ui/events:events_base",
      "//ui/gfx/geometry",
      "//url",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # Bootstrap — compiled as normal Chromium code (no RTTI).
  source_set("aurelian") {
    sources = [
      "bootstrap/browser_main_extra.cc",
      "bootstrap/browser_main_extra.h",
    ]

    deps = [
      ":aurelian_handles",
      "//base",
      "//chrome/browser:main_extra_parts",
      "//chrome/browser/ui",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Dedicated test binary — embedded-subsystem convention (like
  # extensions_browsertests, headless_browsertests).
  test("aurelian_browsertests") {
    sources = [
      "handles/browser/frame_handle_browsertest.cc",
      "handles/browser/input_handle_browsertest.cc",
      "handles/browser/tab_handle_browsertest.cc",
      "handles/network/network_handle_browsertest.cc",
      "renderer/aurelian_wire_browsertest.cc",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    deps = [
      ":aurelian_handles",
      ":aurelian_network",
      "//aurelian/public/mojom",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/browser/ui",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
      "//components/download/public/common:public",
      "//content/public/browser",
      "//content/test:test_support",
      "//mojo/public/cpp/bindings",
      "//net",
      "//net:test_support",
      "//testing/gtest",
      "//third_party/blink/public/common",
      "//url",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]

    data_deps = [ "//chrome" ]
  }
}
