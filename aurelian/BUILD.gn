# Aurelian — Velite's Chromium embodiment.

import("//build/config/compiler/compiler.gni")
import("//testing/test.gni")
import("//testing/test.gni")

declare_args() {
  enable_aurelian = true
}

if (enable_aurelian) {
  _velite_src = "../../../Legion/Velite/src"

  _velite_include_dirs = [
    "$_velite_src/agentspaces-wire/include",
    "$_velite_src/agentspaces/include",
    "$_velite_src/capability/include",
    "$_velite_src/causal/include",
    "$_velite_src/channel/include",
    "$_velite_src/crypto/include",
    "$_velite_src/dataflow/include",
    "$_velite_src/dispatch/include",
    "$_velite_src/envelope/include",
    "$_velite_src/envelopes/include",
    "$_velite_src/fact-log/include",
    "$_velite_src/fact-substrate/include",
    "$_velite_src/forth/include",
    "$_velite_src/forth-handle/include",
    "$_velite_src/handle/include",
    "$_velite_src/host/include",
    "$_velite_src/identity/include",
    "$_velite_src/json/include",
    "$_velite_src/lattices/include",
    "$_velite_src/origin-sequence/include",
    "$_velite_src/resources/include",
    "$_velite_src/substrate/include",
    "$_velite_src/crypto/vendor",
    "$_velite_src/mt/runtime/include",
    "$_velite_src/mt/compiler/include",
  ]

  # Velite handle code — compiled with RTTI (Velite uses dynamic_cast).
  # Network intercept + cookie handles (no RTTI — used by chrome/browser).
  source_set("aurelian_network") {
    sources = [
      "handles/network/network_handle.cc",
      "handles/network/network_handle.h",
    ]

    deps = [
      "//base",
      "//components/download/public/common:public",
      "//content/public/browser",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//third_party/blink/public/common",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Accessibility tree snapshot (C7.a). No RTTI (plain content/ui APIs).
  source_set("aurelian_a11y") {
    sources = [
      "handles/browser/accessibility_handle.cc",
      "handles/browser/accessibility_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
      "//ui/accessibility",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Windows list (C1.y). No RTTI.
  source_set("aurelian_windows") {
    sources = [
      "handles/browser/windows_handle.cc",
      "handles/browser/windows_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/ui:ui",
      "//chrome/browser/ui/tabs:tab_strip",
      "//ui/gfx/geometry",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Tabstrip open / close / activate (C1.x). No RTTI.
  source_set("aurelian_tabstrip") {
    sources = [
      "handles/browser/tabstrip_handle.cc",
      "handles/browser/tabstrip_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/ui:ui",
      "//chrome/browser/ui/tabs:tab_enums",
      "//chrome/browser/ui/tabs:tab_strip",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # System info: browser + renderer process counts (C15.a). No RTTI.
  source_set("aurelian_system") {
    sources = [
      "handles/browser/system_handle.cc",
      "handles/browser/system_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Tab groups group / query / ungroup (C13.c). No RTTI.
  source_set("aurelian_tabgroups") {
    sources = [
      "handles/browser/tabgroups_handle.cc",
      "handles/browser/tabgroups_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/ui/tabs:tab_strip",
      "//components/tab_groups",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Page content info: MIME + encoding (C11.c). No RTTI.
  source_set("aurelian_page_info") {
    sources = [
      "handles/browser/page_info_handle.cc",
      "handles/browser/page_info_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Profile info: incognito state + identity (C13.d). No RTTI.
  source_set("aurelian_profile") {
    sources = [
      "handles/browser/profile_handle.cc",
      "handles/browser/profile_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Browsing history query (C13.e). No RTTI.
  source_set("aurelian_history") {
    sources = [
      "handles/browser/history_handle.cc",
      "handles/browser/history_handle.h",
    ]

    deps = [
      "//base",
      "//components/history/core/browser",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Frame tree listing (C2.x). No RTTI.
  source_set("aurelian_frames") {
    sources = [
      "handles/browser/frames_handle.cc",
      "handles/browser/frames_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Navigation history list (C1.z). No RTTI.
  source_set("aurelian_nav_history") {
    sources = [
      "handles/browser/nav_history_handle.cc",
      "handles/browser/nav_history_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Per-tab process info (C12.a). No RTTI.
  source_set("aurelian_process") {
    sources = [
      "handles/browser/process_handle.cc",
      "handles/browser/process_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Clipboard read / write text (C13.b). No RTTI.
  source_set("aurelian_clipboard") {
    sources = [
      "handles/browser/clipboard_handle.cc",
      "handles/browser/clipboard_handle.h",
    ]

    deps = [
      "//base",
      "//ui/base/clipboard",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Bookmarks add / list / remove (C13.a). No RTTI.
  source_set("aurelian_bookmarks") {
    sources = [
      "handles/browser/bookmarks_handle.cc",
      "handles/browser/bookmarks_handle.h",
    ]

    deps = [
      "//base",
      "//components/bookmarks/browser",
      "//components/bookmarks/common",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # JS dialogs: respond to a pending dialog (C11.b). No RTTI.
  source_set("aurelian_dialogs") {
    sources = [
      "handles/browser/dialogs_handle.cc",
      "handles/browser/dialogs_handle.h",
    ]

    deps = [
      "//base",
      "//components/javascript_dialogs",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Emulation: user-agent override (C11.a). No RTTI.
  source_set("aurelian_emulation") {
    sources = [
      "handles/browser/emulation_handle.cc",
      "handles/browser/emulation_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
      "//third_party/blink/public/common",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Extensions list / enable / disable (C7.b). No RTTI.
  source_set("aurelian_extensions") {
    sources = [
      "handles/browser/extensions_handle.cc",
      "handles/browser/extensions_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
      "//extensions/browser",
      "//extensions/common",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # DevTools CDP-compat command surface (C7.d). No RTTI.
  source_set("aurelian_devtools") {
    sources = [
      "handles/browser/devtools_handle.cc",
      "handles/browser/devtools_handle.h",
    ]

    deps = [
      "//base",
      "//content/public/browser",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Permissions query / grant / revoke via content settings (C7.c). No RTTI.
  source_set("aurelian_permissions") {
    sources = [
      "handles/browser/permissions_handle.cc",
      "handles/browser/permissions_handle.h",
    ]

    deps = [
      "//base",
      "//components/content_settings/core/browser",
      "//components/content_settings/core/common",
      "//url",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Find-in-page observer glue. Kept in a SEPARATE no-RTTI source_set: it
  # subclasses find_in_page::FindResultObserver (-> base::CheckedObserver),
  # whose typeinfo is not emitted in Chromium's no-RTTI build. Subclassing it
  # from the RTTI-compiled aurelian_handles TU would leave an undefined
  # "typeinfo for base::CheckedObserver" at link time, so the observer lives
  # here and the handle code talks to it through the plain find_glue.h API.
  source_set("aurelian_find_glue") {
    sources = [
      "handles/browser/find_glue.cc",
      "handles/browser/find_glue.h",
    ]

    deps = [
      "//base",
      "//components/find_in_page",
      "//content/public/browser",
      "//ui/gfx/geometry",
    ]

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Cap-token attenuation: predicates (C8.a) + signed delegation chain (C8.b).
  # No RTTI; uses Velite's crypto free functions for Ed25519.
  source_set("aurelian_capability") {
    sources = [
      "capability/cap_chain.cc",
      "capability/cap_chain.h",
      "capability/cap_membrane.cc",
      "capability/cap_membrane.h",
      "capability/cap_predicate.cc",
      "capability/cap_predicate.h",
      "capability/cap_wire.cc",
      "capability/cap_wire.h",
    ]

    deps = [
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C9 bring-up external WSS peer (design §13). No RTTI; uses Velite's
  # WebSocket channel/listener + AgentSpace root handle.
  source_set("aurelian_federation") {
    sources = [
      "federation/wss_peer.cc",
      "federation/wss_peer.h",
    ]

    deps = [
      "//base",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # Subscription stream producer (C6). No RTTI (no dynamic_cast here; uses
  # Velite's SubscriptionHandle, whose typeinfo is provided by //velite).
  source_set("aurelian_streams") {
    sources = [
      "handles/streams/mojo_stream_bridge.cc",
      "handles/streams/mojo_stream_bridge.h",
      "handles/streams/subscription_producer.cc",
      "handles/streams/subscription_producer.h",
    ]

    deps = [
      "//aurelian/public/mojom",
      "//base",
      "//mojo/public/cpp/bindings",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }

  # C10: existing asmodeus tab-audio capture routed through a Velite handle.
  # RTTI (Velite handle code).
  source_set("aurelian_audio") {
    sources = [
      "handles/profile/audio_capture_handle.cc",
      "handles/profile/audio_capture_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/asmodeus:asmodeus",
      "//content/public/browser",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # C10: existing asmodeus CredentialStore routed through a Velite handle.
  # RTTI (Velite handle code).
  source_set("aurelian_credentials") {
    sources = [
      "handles/profile/credentials_handle.cc",
      "handles/profile/credentials_handle.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/asmodeus:asmodeus_automation_core",
      "//velite",
    ]

    include_dirs = _velite_include_dirs

    configs -= [
      "//build/config/compiler:no_rtti",
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
    configs += [ "//build/config/compiler:rtti" ]
  }

  # Velite handle code — compiled with RTTI.
  source_set("aurelian_handles") {
    sources = [
      "handles/browser/tab_handle.cc",
      "handles/browser/tab_handle.h",
    ]

    deps = [
