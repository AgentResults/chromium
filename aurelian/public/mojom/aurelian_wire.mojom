// Aurelian wire protocol — Velite AgentSpaces envelopes over Mojo.
// Per AURELIAN-DESIGN.md §6.

module aurelian.mojom;

// Per-frame wire interface. Associated (not plain) so Dispatch
// ordering is preserved relative to navigation IPC.
interface AurelianWire {
  // Dispatch an AgentSpaces envelope. The envelope and reply are
  // opaque byte arrays (simplified for C2; full CBOR in later slices).
  Dispatch(array<uint8> envelope) => (array<uint8> reply);

  // Open a subscription (C6). The envelope names the stream (e.g.
  // "mutations", "console", "test"). The producer (this frame) binds a
  // VeliteSink Remote and returns its receiver to the caller; the caller
  // implements VeliteSink and receives frames until it drops the
  // receiver, which the producer treats as cancel.
  Subscribe(array<uint8> envelope) => (pending_receiver<VeliteSink> sink);

  // Provision this frame membrane's operator trust anchor (a 32-byte Ed25519
  // public key) (C8). The browser hub sets it once at frame bind time from the
  // anchor it cached from Agrippa at boot (design §11.5). Cap-carrying Dispatch
  // envelopes are then verified back to THIS anchor by the renderer membrane
  // itself — the hub does not get to vouch per-cap.
  SetTrustAnchor(array<uint8> anchor_pub);
};

// Reverse channel for subscription frames. One frame each (opaque bytes
// for now). Fire-and-forget.
interface VeliteSink {
  Frame(array<uint8> frame);
};
