+    window_ = window;
+    tracker_ = window ? ui::NativeWindowTracker::Create(window) : nullptr;
+  }
+
+ private:
+  gfx::NativeWindow window_ = gfx::NativeWindow();
+  std::unique_ptr<ui::NativeWindowTracker> tracker_;
