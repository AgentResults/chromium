-
-  if (browser_->tab_strip_model()->group_model()->ContainsTabGroup(group_)) {
-    const int tab_count = browser_->tab_strip_model()
-                              ->group_model()
-                              ->GetTabGroup(group_)
-                              ->tab_count();
