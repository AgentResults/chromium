import("//testing/test.gni")

source_set("audio_ring_buffer") {
  sources = [
    "audio_ring_buffer.cc",
    "audio_ring_buffer.h",
  ]

  deps = [
    "//base",
  ]
}

source_set("asmodeus") {
  sources = [
    "asmodeus_audio_input.cc",
    "asmodeus_audio_input.h",
    "asmodeus_audio_output.cc",
    "asmodeus_audio_output.h",
    "asmodeus_participant_registry.cc",
    "asmodeus_participant_registry.h",
    "asmodeus_virtual_devices.h",
    "audio_ring_buffer.cc",
    "audio_ring_buffer.h",
  ]

  deps = [
    "//base",
    "//media",
  ]
}

# Unit tests for Asmodeus audio components.
# Build with: autoninja -C out/Default asmodeus_audio_tests
# Run with: out/Default/asmodeus_audio_tests
test("asmodeus_audio_tests") {
  sources = [
    "audio_ring_buffer_unittest.cc",
    "asmodeus_audio_output_unittest.cc",
    "asmodeus_audio_input_unittest.cc",
    "participant_registry_unittest.cc",
  ]

  # Don't depend on both :asmodeus and //media — the asmodeus .cc files
  # are compiled as part of //media/audio:audio, so //media provides them.
  # Using both would cause duplicate symbol errors at link time.
  deps = [
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//media",
    "//media:test_support",
    "//testing/gtest",
  ]
}
