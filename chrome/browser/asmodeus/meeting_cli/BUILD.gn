# Standalone meeting coordinator binary.
# Runs native WebRTC meetings without Chrome.

executable("asmodeus_meeting") {
  sources = [ "main.cc" ]

  deps = [
    "//chrome/browser/asmodeus:asmodeus_coordinator_core",
    "//base",
    "//net",
    "//skia",
    "//third_party/libyuv",
  ]
}
