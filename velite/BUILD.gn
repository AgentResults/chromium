  # envelopes/include MUST come before envelope/include so the right
  # velite/envelope.hpp is found.
  include_dirs = [ "$_velite_src/envelopes/include" ] + _velite_include_dirs
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_rtti",
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
