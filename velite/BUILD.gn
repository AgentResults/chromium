# Suppress Chromium-specific warnings for third-party Velite code.
config("velite_warnings") {
  cflags_cc = [
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-extra-semi",
    "-Wno-shorten-64-to-32",
    "-Wno-shadow",
    "-Wno-implicit-fallthrough",
    "-Wno-vla-cxx-extension",
    "-Wno-c99-extensions",
    "-Wno-unused-but-set-variable",
    "-Wno-deprecated-declarations",
    "-Wno-unused-private-field",
  ]
  cflags_c = [
    "-Wno-unused-function",
    "-Wno-sign-compare",
    "-Wno-shorten-64-to-32",
  ]
}

# --- Monocypher (vendored C crypto primitives) ---
source_set("monocypher") {
  sources = [
    "$_velite_src/crypto/vendor/monocypher.c",
    "$_velite_src/crypto/vendor/monocypher-ed25519.c",
  ]
  include_dirs = [ "$_velite_src/crypto/vendor" ]

  # Treat as third-party code: disable Chromium clang plugins.
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_rtti",
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    "//build/config/compiler:rtti",
    ":velite_warnings",
  ]
}

