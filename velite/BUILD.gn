# Federated-KG define for CONSUMERS of //velite (the aurelian source_sets): they
# include conformance_bootstrap.hpp and size ConformanceBootstrap, so they MUST
# see the SAME LEGION_HAS_FEDERATED_KG as velite's own TUs (ODR: the guarded
# kg_handle_concrete_ MEMBER changes the object layout). Propagated to every
# dependent via all_dependent_configs on the static_library below.
config("velite_fkg_public") {
  defines = [ "LEGION_HAS_FEDERATED_KG=1" ]
}

