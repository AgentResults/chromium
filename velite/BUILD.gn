# Suppress Chromium-specific warnings for third-party Velite code.
config("velite_warnings") {
  cflags_cc = [
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-extra-semi",
    "-Wno-shorten-64-to-32",
    "-Wno-shadow",
    "-Wno-implicit-fallthrough",
    "-Wno-vla-cxx-extension",
    "-Wno-c99-extensions",
    "-Wno-unused-but-set-variable",
    "-Wno-deprecated-declarations",
    "-Wno-unused-private-field",
  ]
  cflags_c = [
    "-Wno-unused-function",
    "-Wno-sign-compare",
    "-Wno-shorten-64-to-32",
  ]
  # Federated-KG is present in this build (velite_federated_kg compiled below),
  # so the concrete KGNode surface (kg_concrete/cap_admits + the kg_handle_
  # concrete_ MEMBER) is enabled. This MUST match velite's own CMake
  # (agentspaces-wire/CMakeLists.txt: PUBLIC LEGION_HAS_FEDERATED_KG=1). Defined
  # here so EVERY velite source_set that includes conformance_bootstrap.hpp sees
  # the SAME class layout — an inconsistent define is an ODR violation (the
  # guarded kg_handle_concrete_ member changes the object size). The aurelian
  # consumers get the same define via static_library("velite") all_dependent_configs.
  defines = [ "LEGION_HAS_FEDERATED_KG=1" ]
}

# --- Monocypher (vendored C crypto primitives) ---
source_set("monocypher") {
  sources = [
    "$_velite_src/crypto/vendor/monocypher.c",
    "$_velite_src/crypto/vendor/monocypher-ed25519.c",
  ]
  include_dirs = [ "$_velite_src/crypto/vendor" ]

  # Treat as third-party code: disable Chromium clang plugins.
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_rtti",
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    "//build/config/compiler:rtti",
    ":velite_warnings",
  ]
}

# --- QuickJS engine (vendored C) — mirrors third-party/quickjs-velite/
# CMakeLists.txt. Current velite mt/runtime hard-depends on it (JSON serializer;
# "no parallel serializer"). Forked from quickjs-ng c707cf5. C11, third-party. ---
source_set("qjs_velite") {
  sources = [
    "$_velite_src/../third-party/quickjs-velite/upstream/dtoa.c",
    "$_velite_src/../third-party/quickjs-velite/upstream/libregexp.c",
    "$_velite_src/../third-party/quickjs-velite/upstream/libunicode.c",
    "$_velite_src/../third-party/quickjs-velite/upstream/quickjs.c",
  ]
  include_dirs = [ "$_velite_src/../third-party/quickjs-velite/upstream" ]
  defines = [
    "_GNU_SOURCE",
    "CONFIG_VERSION=\"2026-05-05-c707cf5\"",
    "VELITE_QJS_REPLAY_COMMIT_HASH=\"c707cf5eda67a97bbff7a60cb2ef124fd4a77420\"",
    "VELITE_QJS_REPLAY_PATCH_VERSION=\"replay-api-v1.0\"",
  ]
  # QuickJS's tightly-tuned C source — suppress what the upstream Makefile does
  # (these come after configs' cflags, so they override chromium's -Werror set).
  cflags_c = [
    "-Wno-implicit-fallthrough",
    "-Wno-sign-compare",
    "-Wno-unused-parameter",
    "-Wno-unused-but-set-variable",
    "-Wno-unused-function",
    "-Wno-shadow",
    "-Wno-format-truncation",
    "-Wno-array-bounds",
    "-Wno-unused-variable",
    "-Wno-missing-field-initializers",
  ]
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_rtti",
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
}

