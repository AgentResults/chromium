# Velite substrate — the shared agentspaces-wire + handle layer.
# Option A: GN-native static_library compiling directly from the Legion
# source tree. See design §15 for the decision rationale.
#
# Split into source_sets to avoid .o basename collisions (parser.cpp,
# handle.cpp exist in multiple libraries).

import("//build/config/compiler/compiler.gni")

_velite_src = "../../../Legion/Velite/src"

