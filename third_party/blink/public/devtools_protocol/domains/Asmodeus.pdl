# Asmodeus CDP domain — agent-controlled browser automation.

experimental domain Asmodeus

  # ── Cookie type (self-contained, no Network dependency) ─────

  type Cookie extends object
    properties
      string name
      string value
      string domain
      string path
      number expires
      boolean httpOnly
      boolean secure
      boolean session

  # ── Credential types ────────────────────────────────────────

  type Credential extends object
    properties
      string origin
      string username
      string password
      optional string totpSecret
      optional string notes
      optional number lastUsed

  # ── Auth flow types ─────────────────────────────────────────

  type AuthFlowType extends string
    enum
      login-form
      oauth
      saml
      captcha
      two-factor
      unknown

  type AuthFlowState extends string
    enum
      detected
      in-progress
      completed
      failed

  type AuthFlow extends object
    properties
      AuthFlowType type
      string origin
      AuthFlowState state
      optional string provider
      optional object details

  # ── Login form types ────────────────────────────────────────

  type LoginFormType extends string
    enum
      login
      registration
      two-factor
      password-reset
      unknown

  type LoginForm extends object
    properties
      LoginFormType type
      string usernameSelector
      string passwordSelector
      string submitSelector
      optional array of object extraFields
      optional boolean hasRememberMe
      optional boolean hasForgotPassword

  # ── Session types ───────────────────────────────────────────

  type SessionSnapshot extends object
    properties
      string origin
      array of Cookie cookies
      optional object localStorage
      optional object sessionStorage
      optional number timestamp

  # ── Commands ────────────────────────────────────────────────

  # Enable the Asmodeus domain. Starts auth flow observation.
  command enable

  # Disable the Asmodeus domain. Stops auth flow observation.
  command disable

  # ── Fingerprint suppression ─────────────────────────────────

  # Suppress automation fingerprints (navigator.webdriver, debugger bar, etc.)
  command suppressFingerprints
    parameters
      boolean suppress

  # ── Credential management ───────────────────────────────────

  # Get stored credentials for an origin.
  command getCredentials
    parameters
      string origin
    returns
      array of Credential credentials

  # Save credentials for an origin.
  command saveCredentials
    parameters
      string origin
      string username
      string password
      optional string totpSecret
      optional string notes

  # Delete stored credentials.
  command deleteCredentials
    parameters
      string origin
      string username

  # List all stored credentials.
  command listCredentials
    returns
      array of Credential credentials

  # Generate a TOTP code from a secret.
  command generateTOTP
    parameters
      string secret
      optional integer digits
      optional integer period
    returns
      string code
      number remainingSeconds

  # ── Auth flow detection ─────────────────────────────────────

  # Detect the current auth flow on the page.
  command detectAuthFlow
    returns
      optional AuthFlow flow

  # Get all active auth flows across tabs.
  command getAuthState
    returns
      array of AuthFlow activeFlows

  # ── Login form detection ────────────────────────────────────

  # Detect login form on current page using Chromium's autofill heuristics.
  command detectLoginForm
    returns
      optional LoginForm form

  # Auto-login using stored credentials.
  command autoLogin
    parameters
      string origin
      optional string username
    returns
      boolean success
      optional string error

  # ── Session persistence ─────────────────────────────────────

  # Export session state (cookies + storage) for an origin.
  command exportSession
    parameters
      optional string origin
    returns
      array of SessionSnapshot sessions

  # Import session state from snapshots.
  command importSession
    parameters
      array of SessionSnapshot sessions

  # ── Events ──────────────────────────────────────────────────

  # Fired when an auth flow is detected (OAuth redirect, SAML, CAPTCHA, etc.)
  event authFlowDetected
    parameters
      AuthFlow flow

  # Fired when an auth flow completes or fails.
  event authFlowCompleted
    parameters
      AuthFlow flow
      boolean success

  # ── Virtual Audio ───────────────────────────────────────

  # Enable a named virtual audio device backed by shared memory.
  # Creates ring buffer files that external processes can read/write.
  # Each name creates a separate device, allowing multiple agents
  # to have independent virtual microphones.
  command enableVirtualAudio
    parameters
      optional string name
      optional integer sampleRate
      optional integer channels
    returns
      string deviceId
      string shmPathIn
      string shmPathOut

  # Disable a named virtual audio device and clean up shared memory.
  command disableVirtualAudio
    parameters
      optional string name

  # Get virtual audio status for all devices or a specific one.
  command getVirtualAudioStatus
    parameters
      optional string name
    returns
      boolean enabled
      optional string shmPathIn
      optional string shmPathOut
      optional integer sampleRate
      optional integer channels

  # ── Virtual Camera ───────────────────────────────────────

  # Enable a named virtual camera device backed by shared memory.
  command enableVirtualCamera
    parameters
      optional string name
      optional integer width
      optional integer height
      optional integer fps
    returns
      string deviceId
      string shmPath

  # Disable a named virtual camera device.
  command disableVirtualCamera
    parameters
      optional string name

  # ── Headless Participants ─────────────────────────────────

  # Create a headless meeting participant with its own virtual devices.
  # The participant loads a URL in a hidden WebContents.
  command createParticipant
    parameters
      string name
      string url
      optional string displayName
    returns
      string participantId
      boolean loaded

  # Execute JavaScript in a participant's hidden WebContents.
  command evaluateInParticipant
    parameters
      string name
      string expression
    returns
      optional string result

  # Get participant state.
  command getParticipantState
    parameters
      string name
    returns
      boolean exists
      boolean loaded
      optional string url

  # Destroy a participant and clean up.
  command destroyParticipant
    parameters
      string name

  # ── Page interaction (reliable alternatives to DOM scraping) ──

  # Inject text into the focused input/textarea on the page.
  # More reliable than evaluating JS to set textarea.value because
  # it dispatches proper input events.
  command typeText
    parameters
      string text

  # Click an element matching an aria-label substring.
  # Finds the first visible element whose aria-label contains the
  # given substring and clicks it.
  command clickByAriaLabel
    parameters
      string labelSubstring
    returns
      boolean found
      optional string clickedLabel

  # ── Traffic capture ───────────────────────────────────────
  # Live stream of decoded network traffic. Phase 1: WebRTC signals
  # (every createOffer/setLocalDescription/iceCandidate/stateChange/
  # getStats event from every RTCPeerConnection in every frame of every
  # render process). Phase 2 (future): WebSocket frames, HTTP transactions.

  # Begin capturing. Events (below) fire until captureStop.
  command captureStart
    parameters
      # Substring URL filters on the frame's URL. Empty list = match all.
      optional array of string includeUrlPatterns
      optional array of string excludeUrlPatterns
      # Subsystem toggles (default true).
      optional boolean captureWebRtc
      optional boolean captureWebSocketFrames
      optional boolean captureHttp

  # Stop capturing. Idempotent.
  command captureStop

  # ── Tab Audio Capture ───────────────────────────────────────
  # Captures all audio playing in the inspected tab to a WAV file.
  # Uses Chrome's internal audio capture (same mechanism as chrome.tabCapture).

  # Start capturing tab audio to a WAV file.
  command captureTabAudio
    parameters
      string outputPath
      optional integer sampleRate
      optional integer channels

  # Stop audio capture, return stats.
  # Audio data remains in window.__asmodeusCapture.chunks for CDP client to read.
  command stopAudioCapture
    returns
      number durationMs
      integer samples
      number peakRms
      string outputPath

  # Get current audio level (poll during capture for monitoring).
  command getAudioLevel
    returns
      number rms
      number peak
      boolean capturing

  # ── Meeting Management ──────────────────────────────────────

  # Agent state in a meeting.
  type AgentState extends object
    properties
      string name
      boolean connected
      integer peerCount
      number audioRmsIn
      number audioRmsOut
      optional integer heardCount
      optional integer speechCount
      optional integer bargeInCount
      optional string lastHeard
      optional string lastSpoken
      optional boolean speaking
      optional integer speakingFrames

  type TranscriptEntry extends object
    properties
      string speaker
      string text
      string type
      number timestampMs

  # ── Meeting monitoring events (push, no polling) ───────

  # Agent started speaking (TTS output beginning).
  event agentSpoke
    parameters
      string name
      string text
      string source

  # Agent finished speaking.
  event agentSpeechEnded
    parameters
      string name
      number durationMs

  # Agent heard speech from another agent (STT result).
  event agentHeard
    parameters
      string name
      string text
      integer sttMs

  # Agent was interrupted by another speaker.
  event agentBargeIn
    parameters
      string name

  # Agent's speaking state changed (for lip sync tracking).
  # Fires only from speech_started/speech_ended events, not RMS ticks.
  event agentSpeakingChanged
    parameters
      string name
      boolean speaking

  # Agent encountered an error.
  event agentError
    parameters
      string name
      string message

  # Get the meeting transcript (all speech and heard events).
  command getTranscript
    returns
      array of TranscriptEntry entries

  # Join an external meeting platform (Meet, Teams, Slack, etc.).
  # Auto-detects platform from URL if not specified.
  command joinMeeting
    parameters
      string url
      optional string platform
    returns
      boolean joined
      string platform

  # Create a meeting room with embedded signaling + HTTP server.
  command createMeeting
    parameters
      optional string name
      optional string meetingHtml
    returns
      string meetingUrl
      string signalingUrl
      integer port

  # Add an agent to the meeting. Creates participant + virtual devices.
  command addAgent
    parameters
      string name
      optional string voiceModel
      optional string displayName
    returns
      string participantId
      string audioShmPath
      string videoShmPath
      boolean connected
      integer controlPort

  # Remove an agent from the meeting.
  command removeAgent
    parameters
      string name

  # Get the current meeting state.
  command getMeetingState
    returns
      array of AgentState agents
      integer signalingPeers
      boolean recording

  # Make an agent speak via TTS.
  command speak
    parameters
      string name
      string text
    returns
      boolean queued

  # Start recording the meeting.
  command startRecording
    parameters
      string outputDir
    returns
      boolean started

  # Stop recording and produce MP4.
  command stopRecording
    returns
      integer frames
      integer audioSamples
      number peakRms
      string mp4Path

  # ── General-purpose page interaction ────────────────────────

  # Click an element by text content, aria-label, or CSS selector.
  # method: "text", "textContains", "ariaLabel", "selector"
  command clickElement
    parameters
      string target
      optional string method
    returns
      boolean found
      optional string elementTag
      optional string elementText

  # Type text into an element matched by CSS selector.
  # If no selector, types into the currently focused element.
  command typeInto
    parameters
      string text
      optional string selector
    returns
      boolean success

  # Read text content of an element.
  command readElement
    parameters
      string selector
    returns
      optional string text
      optional string value
      optional string tag

  # Get current page info.
  command getPageInfo
    returns
      string url
      string title

  # ── Authentication automation ──────────────────────────────

  # Sign in to Google with stored credentials from accounts.json.
  command signIn
    parameters
      string agentName
    returns
      boolean started
      optional string currentPage

  # Enter a 2FA verification code.
  command enter2FACode
    parameters
      string code
    returns
      boolean submitted

  # Get the current authentication state.
  command getSignInState
    returns
      boolean signingIn
      optional string currentPage
      optional string agentName

  # ── Permission management ──────────────────────────────────

  # Set auto-grant mode for all permissions (mic, camera, etc.).
  command setAutoGrantPermissions
    parameters
      boolean enabled
    returns
      boolean success

  # Grant or deny a specific permission.
  command setPermission
    parameters
      string permission
      boolean granted
    returns
      boolean success

  # ── Instance management ────────────────────────────────────

  # Launch a Chrome instance for an agent with its own profile.
  command launchInstance
    parameters
      string agentName
      optional string profilePath
      optional integer port
    returns
      integer cdpPort
      string profilePath
      string audioInShm
      string audioOutShm

  # Stop a Chrome instance.
  command stopInstance
    parameters
      string agentName

  # List all running Chrome instances.
  command listInstances
    returns
      array of AgentState instances

  # ── Events ──────────────────────────────────────────────────

  # WebRTC peer-connection signaling event.
  event webRtcSignal
    parameters
      integer peerConnectionId
      string eventType
      string sdpType
      string sdp
      string candidate
      string iceState
      string connState
      string value
      string frameUrl
      number timestamp
